{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictOutputAccessModifiers": true
  },
  "include": [
    "src/**/*.ts",
    "src/typings.d.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]

}
